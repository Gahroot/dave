{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DAVE",
  "version": "1.0.0",
  "identifier": "com.dave.portfolio-command-center",
  "build": {
    "frontendDist": "../desktop/loading"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "capabilities": ["loading-page"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "public.app-category.developer-tools",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/node"],
    "resources": { "resources/server/": "server/" },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "./Entitlements.plist",
      "hardenedRuntime": true
    }
  }
}
