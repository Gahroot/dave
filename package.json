{
  "name": "portfolio-command-center",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "npm run build && node --experimental-strip-types src/server/index.ts",
    "server": "node --experimental-strip-types src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "desktop:stage": "node scripts/desktop/stage-node.mjs && node scripts/desktop/stage-server.mjs",
    "desktop:dev": "npm run desktop:stage && tauri dev",
    "desktop:build": "npm run desktop:stage && tauri build"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@fontsource/inter": "5.3.0",
    "@mantine/core": "8.3.18",
    "@mantine/hooks": "8.3.18",
    "@napi-rs/keyring": "2.0.0",
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@prestyj/ai": "5.17.0",
    "fastify": "^5.2.1",
    "js-yaml": "^5.4.2",
    "lucide-react": "1.47.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "postcss": "^8.5.3",
    "postcss-preset-mantine": "^1.17.0",
    "typescript": "^7.0.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
